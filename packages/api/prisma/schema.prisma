// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // provider = "sqlite"
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // url      = "file:../data.db"
}

model adminUser {
  id        String   @id @default(uuid(7))
  username  String
  password  String
  role      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid(7))
  wxid      String?  @unique
  nickname  String?
  username  String?
  addressId String?   @unique
  gender    Int      @default(0) // 性别 0 - 男 1 - 女
  address   Address?  @relation(fields: [addressId], references: [id])
  createdAt DateTime @default(now())
  pets      Pet[]
  avatar    String?
  phone     String?
  books     Book[]
  advise    Advise[]
  wxAccessToken WxAccessToken[]
  tickets   Ticket[]
  evaluates  Evaluate[]
}

model Address {
  id        String   @id @default(uuid(7))
  province  String?
  city      String?
  area      String?
  detail    String?
  userId    String?
  user      User?
  createdAt DateTime @default(now())
  Book      Book[]
}

model Pet {
  id        String   @id @default(uuid(7))
  petname  String?
  weight    Int?    // 0~5->1  5~10->2  求值公式Math.ceil(n / 5)
  age       Int?
  images    Image[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  type      String // 宠物父类型
  subType   String // 宠物子类型
  bookId    String?
  book      Book?
  statu     Int      @default(1) // 宠物的状态 1-活着 2-死亡
  petImage  PetImage[]
}

model Image {
  id         String    @id @default(uuid(7))
  path       String
  title      String
  createdAt   DateTime  @default(now())
  userId     String?
  Pet        Pet?      @relation(fields: [petId], references: [id]) //  关联字段-宠物
  petId      String?
  bookGoodId String?
  bookGood   BookGood? // 关联字段-预约附加服务产品
  ticketId   String?   @unique
  ticket     Ticket?
  petImage   PetImage[]
  menuImage   MenuRelationImage[]
}

// 预约附加服务产品
model BookGood {
  id      String  @id @default(uuid(7))
  price   Int // 价格,单位为分
  title   String // 产品名称
  createdAt DateTime  @default(now())  //  创建时间
  thumbId String? @unique // 缩略图
  thumb   Image?  @relation(fields: [thumbId], references: [id])
  content String // 产品描述
  book    BookRelationBookGood[]
}

// 预约单
model Book {
  id              String     @id @default(uuid(7))
  menuId          String      // 套餐类型,默认为套餐1
  menu            Menu        @relation(fields: [menuId], references: [id])
  bookDateTime    DateTime? // 预约上门时间
  handleWay       Int        @default(1) // 处理方式 1-无需处理 2-自行提取 3-放弃处理
  handleDateTime  DateTime?   // 邮寄时间/提取时间
  addressId       String?
  address         Address?   @relation(fields: [addressId], references: [id])
  isRite          Int        @default(2) // 是否需要仪式
  riteDateTime    DateTime? // 仪式时间
  petId           String     @unique // 宠物
  pet             Pet        @relation(fields: [petId], references: [id])
  totalAmount     Int // 总金额
  payAmount       Int? // 付款金额
  payChannel      Int        @default(1) // 付款渠道 1-微信
  bookGoods       BookRelationBookGood[]
  mark            String? // 备注
  channel         Int        @default(1) // 订单渠道来源 1-平台
  statu           Int        @default(0) // 0待付款  1已预约  2待寄送  3已完成  4已取消 5异常 6退款中
  userId          String     // 下单用户
  user            User       @relation(fields: [userId], references: [id])
  ticketId        String?    @unique
  ticket          Ticket?
  outTradeNo      String?    // 支付订单号
  outRefundNo     String?     // 退款订单号
  transactionId   String?  // 支付结果订单号
  createdAt       DateTime    @default(now())
  phone           String?
  username        String?
  evaluateId      String?
  evaluate        Evaluate?
  expressNo       String? // 寄送的快递单号
  expressName     String? // 寄送的快递名称
  updatedAt       DateTime?  @updatedAt
  isSelfExpress   Int?        @default(2) // 是否自送  1-是   2-否
  petStoreId      String?    // 自送宠物门店，如果expressWay选择的是2的话这个字段需要传递过来
  petStore        PetStore?  @relation(fields: [petStoreId], references: [id])
  expressWay      Int?       // 宠物接收方式 0-未知  1-自送 2-门店接受 3-上门收取
  expressDateTime DateTime?  // 上门收取的时间, 如果expessWay为3的时候这个字段需要传递过来
}

// 订单关联的附加服务 多对多中间表
model BookRelationBookGood {
  id          String  @id @default(uuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id])
  bookGoodId  String
  bookGood    BookGood @relation(fields: [bookGoodId], references: [id])
}

// 发票
model Ticket {
  id        String   @id @default(uuid())
  bookId    String   @unique
  book      Book     @relation(fields: [bookId], references: [id])
  createdAt DateTime @default(now())
  statu     Int      @default(2) //  开票状态 2 - 未开票 1 - 已开票 3 - 用户催票
  header    String? // 发票抬头
  type      Int      @default(1) // 发票类型 1-个人 2 - 企业
  number    String? // 税号
  email     String // 邮箱
  fileId    String?  @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  file      Image?   @relation(fields: [fileId], references: [id])
}

// 投诉建议
model Advise {
  id            String   @id @default(uuid())
  type          Int      @default(1) // 投诉建议类型 1-建议 2-投诉
  content       String
  replayAt      Int?
  replayContent String?
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
}

// 微信token临时存储表
model WxAccessToken {
  id      String  @id @default(uuid())
  token   String
  createdAt String
  expiresIn Int
  userId   String
  user    User  @relation(fields: [userId], references: [id])
}

// todo: 评价表
model Evaluate {
  id      String @id  @default(uuid())
  content String
  score  Int     @default(5)
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  bookId  String  @unique
  book    Book   @relation(fields: [bookId], references: [id])
}

// 宠物跟图片的关联表
model PetImage {
  id      String @id @default(uuid())
  petId   String
  pet     Pet    @relation(fields: [petId], references: [id])
  imageId String
  image   Image  @relation(fields: [imageId], references: [id])
}

// 套餐表
model Menu {
  id      String  @id @default(uuid())
  name    String
  price   Int   
  description String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  images  MenuRelationImage[]
  book    Book[]
  isRite  Int @default(2) // 是否需要仪式 1 是 2否
  isHandleWay Int @default(2) // 是否需要寄送回收 1 是 2 否
  expressWays  String?  // 宠物寄送方式，可多选，用顿号分割开
}

// 套餐图片关联表
model MenuRelationImage {
  id    String  @id @default(uuid())
  menuId  String
  menu   Menu   @relation(fields: [menuId], references: [id])
  imageId String
  image   Image @relation(fields: [imageId], references: [id])
}

// 宠物门店表
model PetStore {
  id  String  @id @default(uuid())
  name  String // 店名
  address String // 门店地址
  price Int?  // 门店收费价格
  tel String? // 门店联系方式
  contact String? // 门店对接人
  books Book[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
